FROM debian:12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    gcc-mingw-w64-x86-64 \
    g++-mingw-w64-x86-64 \
    make \
    curl \
    git \
    xz-utils \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Nim 2.2.10 via choosenim
RUN curl -sSf https://nim-lang.org/choosenim/init.sh | CHOOSENIM_CHOOSE_VERSION=2.2.10 bash -s -- -y \
    && chmod a+x /root \
    && chmod -R a+rX /root/.nimble /root/.choosenim
ENV HOME=/root
ENV PATH="/root/.nimble/bin:${PATH}"

WORKDIR /build

FROM golang:1.26

ENV GOTOOLCHAIN=auto

RUN go install mvdan.cc/garble@latest

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc-mingw-w64-x86-64 \
    git \
    ca-certificates \
    python3 \
    python3-pip \
    libssl-dev openssl \
    && rm -rf /var/lib/apt/lists/*

RUN go install github.com/Tylous/Limelighter@latest \
    && cp /go/bin/Limelighter /usr/local/bin/

RUN git clone --depth 1 https://github.com/Whispergate/Shellcrypt.git /opt/shellcrypt \
    && pip3 install --no-cache-dir --break-system-packages -r /opt/shellcrypt/requirements.txt

RUN chmod a+x /root \
    && mkdir -p /root/.cache \
    && chmod -R a+rwX /root/.cache /go
ENV HOME=/root
ENV SHELLCRYPT=/opt/shellcrypt/main.py

WORKDIR /build
